{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "composite": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    // Los tests los typechequea vitest con su propia config (vite/vitest.d.ts).
    // Excluirlos aquí evita que tsc intente resolver tipos de vitest (expect, describe, etc.)
    // sin las declaraciones de ambiente de vitest, lo que causaría errores en 'tsc --noEmit'.
    // Para typecheck de tests, usa: vitest --typecheck (o añade un tsconfig.test.json).
    "src/__tests__"
  ]
}
