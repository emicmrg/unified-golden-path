# .env.example — Build environment variables for web-dashboard
# Copy this file to .env.local and fill in the real values from the CDK stack (infra/dashboard-stack).
# CDK outputs are mapped to these variables (cdk deploy exports the values).
# NEVER commit .env.local with real values.

# ─────────────────────────────────────────────
# LIVE TELEMETRY (MQTT over WebSocket)
# ─────────────────────────────────────────────

# Cognito Identity Pool ID for guest credentials (no login).
# Example: us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# CDK Output: DashboardStack/IdentityPoolId
VITE_IDENTITY_POOL_ID=

# AWS Region where the stack is deployed.
# Default: us-east-1 (the code uses this if the variable is not defined)
VITE_AWS_REGION=us-east-1

# AWS IoT Core ATS endpoint (without protocol, without trailing slash).
# Found at: AWS Console → IoT Core → Settings → Device data endpoint
# Example: example1234abcd-ats.iot.us-east-1.amazonaws.com
# CDK Output: DashboardStack/IotEndpoint
VITE_IOT_ENDPOINT=

# MQTT topic to subscribe to for receiving gateway telemetry.
# Example: ugp/telemetry/ugp-gateway-01
# CDK Output: DashboardStack/TelemetryTopic
VITE_TELEMETRY_TOPIC=ugp/telemetry/ugp-gateway-01

# MQTT clientId prefix.
# The IoT Core guest role only allows connections with a clientId that starts with this prefix.
# The IAM policy applies to resource: "client/${mqttClientIdPrefix}*"
# CDK Output: DashboardStack/MqttClientIdPrefix
VITE_MQTT_CLIENT_ID_PREFIX=ugp-dashboard-

# ─────────────────────────────────────────────
# STATUS (polling — pipeline + crew + circuit breaker)
# ─────────────────────────────────────────────

# Read-only Lambda Function URL that returns system status.
# Format: https://<id>.lambda-url.<region>.on.aws/
# CDK Output: DashboardStack/StatusApiUrl
VITE_STATUS_API_URL=
